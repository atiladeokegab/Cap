{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "film/contracts/edit.schema.json",
  "title": "edit",
  "type": "object",
  "required": [
    "shots"
  ],
  "properties": {
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "take_id",
          "sentence_ids"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "take_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "sentence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "minItems": 1
          },
          "zoom_event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "minItems": 0
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
