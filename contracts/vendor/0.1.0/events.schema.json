{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "film/contracts/events.schema.json",
  "title": "events",
  "type": "object",
  "required": [
    "events"
  ],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "segment",
          "time_ms",
          "crop"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "type": {
            "enum": [
              "click",
              "key_burst",
              "window",
              "shot"
            ]
          },
          "segment": {
            "type": "integer",
            "minimum": 0
          },
          "time_ms": {
            "type": "integer",
            "minimum": 0
          },
          "window": {
            "type": "string"
          },
          "crop": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "shot_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      },
      "minItems": 0
    }
  }
}
