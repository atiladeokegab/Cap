{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "film/contracts/take-manifest.schema.json",
  "title": "take-manifest",
  "type": "object",
  "required": [
    "files",
    "fork_commit",
    "contracts_version",
    "project_format_version"
  ],
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "(^/|(^|/)\\.\\.(/|$))"
            }
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "fork_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "contracts_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "project_format_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
