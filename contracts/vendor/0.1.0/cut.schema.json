{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "film/contracts/cut.schema.json",
  "title": "cut",
  "type": "object",
  "required": [
    "scenes"
  ],
  "properties": {
    "size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "music": {
      "type": "object",
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "card",
              "clip",
              "split"
            ]
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "card"
                }
              }
            },
            "then": {
              "required": [
                "duration"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "split"
                }
              }
            },
            "then": {
              "required": [
                "duration",
                "left",
                "right"
              ],
              "properties": {
                "left": {
                  "type": "object",
                  "required": [
                    "src"
                  ],
                  "properties": {
                    "src": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                },
                "right": {
                  "type": "object",
                  "required": [
                    "src"
                  ],
                  "properties": {
                    "src": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "clip"
                }
              }
            },
            "then": {
              "required": [
                "src",
                "segments",
                "panel"
              ],
              "properties": {
                "src": {
                  "type": "string",
                  "minLength": 1
                },
                "segments": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "panel": {
                  "type": "object",
                  "required": [
                    "rect",
                    "crop"
                  ],
                  "properties": {
                    "rect": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "crop": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    }
  }
}
